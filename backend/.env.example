# ==========================================
# FIRE-EYE Backend Environment Variables
# ==========================================

# Database
# Use postgresql+psycopg2 for SQLAlchemy with PostGIS
DATABASE_URL=postgresql+psycopg2://fireuser:firepassword@127.0.0.1:5433/firedb

# Redis (for Pub/Sub and caching)
REDIS_URL=redis://localhost:6379/0

# Authentication
SECRET_KEY=generate_a_secure_random_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Mesh Gateway
MESH_GATEWAY_NODE_ID=GATEWAY-CENTRAL-01
DEFAULT_TTL=8

# ML Prediction Service
# Relative path to the pre-trained joblib model (optional, falls back to heuristic)
ML_MODEL_PATH=../ml/landslide_model.joblib

# Fast API Settings
ENVIRONMENT=production
PROJECT_NAME="FIRE-EYE Disaster Response Engine"
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
FCM_SERVER_KEY=
