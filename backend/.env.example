PROJECT_NAME="FIRE-EYE Disaster Response Engine"
ENVIRONMENT="development"
PORT=8000
HOST="0.0.0.0"

# Database Configuration (SQLite default for hackathon instant zero-config setup, or PostgreSQL)
DATABASE_URL="sqlite:///./fire_eye.db"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fire_eye"

# Security
SECRET_KEY="fire_eye_super_secret_hackathon_jwt_key_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Mesh Network Config
MESH_GATEWAY_NODE_ID="GATEWAY-CENTRAL-01"
DEFAULT_TTL=8
